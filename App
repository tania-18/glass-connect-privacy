<style>
:root{--bg:#0A0C10;--card:#12151C;--panel:#1A1E28;--cy:#00D4FF;--vi:#7C3AED;--ok:#10B981;--wa:#F59E0B;--er:#EF4444;--tx:#F1F5F9;--mu:#94A3B8;--bd:#1E2330;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
:root[data-theme="light"]{--bg:#F1F5F9;--card:#FFFFFF;--panel:#E8EDF4;--tx:#0A0C10;--mu:#475569;--bd:#D5DCE6}
*{box-sizing:border-box;margin:0}
html,body{height:100%}
body{background:var(--bg);color:var(--tx);font:400 14px/1.45 Inter,system-ui,sans-serif;display:flex;justify-content:center}
#app{width:100%;max-width:430px;height:100%;display:flex;flex-direction:column;position:relative;overflow:hidden}
button{font:inherit;color:inherit;cursor:pointer;border:0;background:none;transition:transform .1s}
button:active{transform:scale(.95)}
button:focus-visible,input:focus-visible,select:focus-visible{outline:2px solid var(--cy);outline-offset:2px}
input,select,textarea{font:inherit;color:var(--tx);background:var(--panel);border:1px solid var(--bd);border-radius:12px;padding:11px 12px;width:100%}
h1{font-size:26px;font-weight:700}h2{font-size:18px;font-weight:700}h3{font-size:15px;font-weight:600}
.mono{font-family:'JetBrains Mono',monospace}
.mu{color:var(--mu)}.sm{font-size:12px}
.card{background:var(--card);border:1px solid var(--bd);border-radius:16px;padding:14px;margin-bottom:12px;backdrop-filter:blur(12px)}
.btn{background:var(--cy);color:#04141A;font-weight:600;border-radius:12px;padding:12px 16px;width:100%}
.btn.g{background:none;border:1px solid var(--bd);color:var(--tx)}
.btn.d{background:none;border:1px solid var(--er);color:var(--er)}
.row{display:flex;align-items:center;gap:10px}.sp{justify-content:space-between}.col{display:flex;flex-direction:column;gap:10px}
.main{flex:1;overflow-y:auto;padding:12px 14px 20px}
header{display:flex;align-items:center;justify-content:space-between;padding:10px 14px;border-bottom:1px solid var(--bd)}
.dot{width:9px;height:9px;border-radius:50%;background:var(--ok);animation:p 1.6s infinite}
.dot.off{background:var(--er);animation:none}
@keyframes p{50%{box-shadow:0 0 0 6px transparent;opacity:.6}0%{box-shadow:0 0 0 0 rgba(16,185,129,.5)}}
nav{display:flex;border-top:1px solid var(--bd);background:var(--card);padding-bottom:6px}
nav button{flex:1;padding:9px 0 5px;color:var(--mu);font-size:11px;position:relative}
nav button.on{color:var(--cy)}
nav button.on::after{content:"";position:absolute;left:30%;right:30%;bottom:0;height:2px;background:var(--cy);box-shadow:0 0 8px var(--cy)}
nav svg{display:block;margin:0 auto 2px}
.badge{position:absolute;top:3px;left:55%;background:var(--er);color:#fff;border-radius:9px;font-size:10px;padding:0 5px}
.pill{display:inline-block;border-radius:20px;padding:2px 9px;font-size:11px;font-weight:600}
.chips{display:flex;gap:6px;overflow-x:auto;margin-bottom:12px}
.chip{padding:6px 12px;border-radius:20px;border:1px solid var(--bd);white-space:nowrap}
.chip.on{background:var(--cy);color:#04141A;border-color:var(--cy)}
.tog{width:46px;height:26px;border-radius:13px;background:var(--panel);border:1px solid var(--bd);position:relative;flex:none}
.tog::after{content:"";position:absolute;top:2px;left:2px;width:20px;height:20px;border-radius:50%;background:var(--mu);transition:.2s}
.tog.on{background:var(--cy)}.tog.on::after{left:22px;background:#fff}
.tog:disabled{opacity:.4}
.stream{position:relative;aspect-ratio:16/9;border-radius:16px;overflow:hidden;background:#000;margin-bottom:12px}
.stream canvas{width:100%;height:100%;display:block}
.ov{position:absolute;font-size:11px;padding:3px 8px;border-radius:8px;background:rgba(10,12,16,.65);color:#F1F5F9}
.live{top:8px;left:8px;background:var(--er);font-weight:700}
.bar{height:8px;border-radius:4px;background:var(--panel);overflow:hidden}.bar i{display:block;height:100%;background:var(--cy);transition:width .6s}
.sheet{position:absolute;inset:0;background:rgba(0,0,0,.6);display:flex;align-items:flex-end;z-index:5}
.sheet>div{background:var(--card);width:100%;border-radius:20px 20px 0 0;padding:16px;max-height:85%;overflow:auto}
.center{flex:1;display:flex;flex-direction:column;justify-content:center;padding:24px;gap:12px}
.toast{position:absolute;top:12px;left:50%;transform:translateX(-50%);background:var(--panel);border:1px solid var(--cy);padding:9px 14px;border-radius:12px;z-index:9;font-size:13px;max-width:90%}
.skel{height:14px;border-radius:6px;background:linear-gradient(90deg,var(--panel),var(--bd),var(--panel));background-size:200% 100%;animation:sh 1.2s infinite}
@keyframes sh{to{background-position:-200% 0}}
.task.today{border-color:var(--cy)}.done h3{text-decoration:line-through;color:var(--mu)}
.off-banner{background:rgba(245,158,11,.15);border:1px solid var(--wa);color:var(--wa);padding:8px 12px;border-radius:12px;margin-bottom:12px}
@media(prefers-reduced-motion:reduce){*{animation:none!important}}

.auth{flex:1;overflow-y:auto;padding:24px 22px}
.authin{min-height:100%;display:flex;flex-direction:column;justify-content:center;gap:12px}
.logo{width:52px;height:52px;border-radius:16px;background:linear-gradient(135deg,var(--cy),var(--vi));display:grid;place-items:center;font-size:26px;color:#04141A;margin-bottom:2px}
.gbtn{background:#fff;color:#1f1f1f;border:1px solid #dadce0;border-radius:12px;padding:12px 16px;width:100%;font-weight:600;display:flex;align-items:center;justify-content:center;gap:10px}
.gbtn:disabled{opacity:.6}
.divider{display:flex;align-items:center;gap:10px;color:var(--mu);font-size:12px}
.divider::before,.divider::after{content:"";flex:1;height:1px;background:var(--bd)}
.seg{display:flex;background:var(--panel);border-radius:12px;padding:4px;border:1px solid var(--bd)}
.seg button{flex:1;padding:8px;border-radius:9px;color:var(--mu);font-weight:600}
.seg button.on{background:var(--cy);color:#04141A}
.fld label{display:block;font-size:12px;color:var(--mu);margin-bottom:4px;font-weight:600}
.pwwrap{position:relative}.pwwrap input{padding-right:64px}
.eye{position:absolute;right:6px;top:50%;margin-top:-15px;font-size:12px;color:var(--cy);padding:6px 8px;font-weight:600}
.err{background:rgba(239,68,68,.12);border:1px solid var(--er);color:var(--er);padding:9px 12px;border-radius:12px;font-size:13px}
.okmsg{background:rgba(16,185,129,.12);border:1px solid var(--ok);color:var(--ok);padding:9px 12px;border-radius:12px;font-size:13px}
.meter{height:5px;border-radius:3px;background:var(--panel);overflow:hidden;margin-top:6px}
.meter i{display:block;height:100%;width:0;transition:width .2s,background .2s}
.linkbtn{color:var(--cy);font-size:13px;font-weight:600}
.avatar{width:42px;height:42px;border-radius:50%;background:var(--cy);color:#04141A;display:grid;place-items:center;font-weight:700;flex:none}
.btn:disabled{opacity:.6}
</style>
