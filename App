function authView(){
 const m=S.authMode,b=S.busy;
 const fld=(id,label,type,val,ph,ac)=>`<div class="fld"><label for="${id}">${label}</label><input id="${id}" type="${type}" placeholder="${ph}" autocomplete="${ac}" value="${esc(val)}"></div>`;
