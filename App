async function authGo(){
 if(S.busy)return;
 const m=S.authMode,email=S.em.trim(),pw=S.pw;
 S.err='';S.info='';
 const bad=msg=>{S.err=msg;S.busy=false;render()};
 const emailOk=/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(email);
 const pwOk=pw.length>=8&&/[A-Za-z]/.test(pw)&&/\d/.test(pw);
 try{
  if(m=='reset'){
   if(!pwOk)return bad('Use 8+ characters with letters and numbers.');
   if(pw!==S.pw2)return bad('The two passwords do not match.');
   S.busy=true;render();
   const r=await db.auth.updateUser({password:pw});
   if(r.error)return bad(friendly(r.error.message));
   S.pw=S.pw2='';S.authMode='in';S.busy=false;toast('Password updated');
   const g=await db.auth.getSession();if(g.data.session){S.user=g.data.session.user;enterApp()}else render();
   return;
  }
  if(!emailOk)return bad('Enter a valid email address.');
  if(m=='forgot'){
   S.busy=true;render();
   const r=await db.auth.resetPasswordForEmail(email,{redirectTo:location.origin+location.pathname});
   S.busy=false;
   if(r.error)return bad(friendly(r.error.message));
   S.info='If an account exists for '+email+', a reset link is on its way.';return render();
  }
  if(m=='up'){
   if(S.nm.trim().length<2)return bad('Enter your full name.');
   if(!pwOk)return bad('Use 8+ characters with letters and numbers.');
   if(pw!==S.pw2)return bad('The two passwords do not match.');
  }else if(!pw)return bad('Enter your password.');
  S.busy=true;render();
  if(m=='up'){
   const r=await db.auth.signUp({email,password:pw,options:{data:{full_name:S.nm.trim()},emailRedirectTo:location.origin+location.pathname}});
   if(r.error)return bad(friendly(r.error.message));
   if(r.data.user&&r.data.user.identities&&r.data.user.identities.length===0)return bad('An account with this email already exists. Try signing in.');
   S.busy=false;
   if(r.data.session){S.user=r.data.user;S.pw=S.pw2='';return enterApp()}
   S.authMode='check';return render();
  }
  const r=await db.auth.signInWithPassword({email,password:pw});
  if(r.error){
   if(/not confirmed/i.test(r.error.message)){S.busy=false;S.authMode='check';return render()}
   return bad(friendly(r.error.message));
  }
  S.busy=false;S.user=r.data.user;S.pw=S.pw2='';enterApp();
 }catch(err){bad('Network problem. Check your connection and try again.')}
}
