function pwStrength(p){
 let sc=0;if(p.length>=8)sc++;if(p.length>=12)sc++;if(/[a-z]/.test(p)&&/[A-Z]/.test(p))sc++;if(/\d/.test(p))sc++;if(/[^A-Za-z0-9]/.test(p))sc++;
 const L=[['Too weak','var(--er)'],['Weak','var(--er)'],['Fair','var(--wa)'],['Good','var(--ok)'],['Strong','var(--ok)'],['Strong','var(--ok)']];
