 const gr=g.createLinearGradient(0,0,0,360);gr.addColorStop(0,'#1c2433');gr.addColorStop(1,'#0c1018');g.fillStyle=gr;g.fillRect(0,0,640,360);
 g.fillStyle='#232c3d';g.fillRect(60,120,200,170);g.fillStyle='#2b3650';g.fillRect(400,80,170,210);g.fillStyle='rgba(0,212,255,.08)';g.fillRect(0,300,640,60);
 if(S.sec||S.alone){const x=320+Math.sin(t/2)*200;g.fillStyle='rgba(0,212,255,.25)';g.fillRect(x-30,150,60,150);g.strokeStyle='#00D4FF';g.strokeRect(x-30,150,60,150)}
 const el=$('#ts');if(el)el.textContent=new Date().toLocaleString()}
document.addEventListener('click',e=>{const el=e.target.closest('[data-a],[data-t],[data-q],[data-f],[data-v],[data-d],[data-c],[data-x],[data-p],[data-dc]');if(!el)return;const d=el.dataset;
 if(d.t){S.tab=d.t;if(d.t=='Alerts')S.unread=0;return render()}
 if(d.q){S.q=d.q;return toast('Stream set to '+d.q)}
 if(d.f){S.filter=d.f;return render()}
 if(d.v){S.view=d.v;if(d.v=='Calendar'){S.loading=true;setTimeout(()=>{S.loading=false;render()},700)}return render()}
 if(d.d){S.day=+d.d;return render()}
 if(d.c){const t=S.tasks.find(t=>t.id==d.c);t.done=t.done?0:1;if(S.google)gSetDone(d.c,t.done).catch(e=>{t.done=t.done?0:1;toast(e.message)});return render()}
 if(d.x){S.tasks=S.tasks.filter(t=>t.id!=d.x);if(S.google)gDel(d.x).catch(e=>{toast(e.message);loadTasks()});return render()}
 if(d.dc){S.contacts.splice(+d.dc,1);return render()}
 if(d.p){pr=d.p;document.querySelectorAll('[data-p]').forEach(b=>{b.classList.toggle('on',b.dataset.p==pr)});return}
 const a=d.a;if(a=='x2'&&e.target!==el)return;
 const m={go:()=>{authGo()},tosignin:()=>{S.authMode='in';S.err='';S.info=''},tosignup:()=>{S.authMode='up';S.err='';S.info=''},toforgot:()=>{S.authMode='forgot';S.err='';S.info=''},showpw:()=>{S.showPw=!S.showPw},resend:()=>{resendEmail()},
 gsign:()=>{GOOGLE_OAUTH(true)},rescan:()=>{loadMirrors()},
 cam:()=>{S.camOn=!S.camOn;try{localStorage.setItem('gc_cam',S.camOn?'1':'0')}catch(e){}if(!S.camOn){S.sec=false;S.alone=false;toast('Camera is off. Security and fall detection are paused.')}else toast('Camera is on')},
 adv:()=>{S.adv=!S.adv},notif:()=>{if('Notification' in window)Notification.requestPermission().then(()=>render())},
 switchm:()=>{try{localStorage.removeItem('gc_mirror')}catch(e){}S.mirror=null;S.screen='connect';loadMirrors()},
 pair:(d)=>{const r=S.mirrors.find(x=>x.id==d.m);if(r){applyMirror(r);try{localStorage.setItem('gc_mirror',JSON.stringify(r))}catch(e){}}S.screen='app';S.tab='Alerts'},
 sec:()=>{S.sec=!S.sec;toast(S.sec?'Security mode activated. The mirror is monitoring for intrusions.':'Security mode off')},
 alone:()=>{if(S.alone){S.alone=false}else{S.sheet='alone'}},yesalone:()=>{S.alone=true;S.sheet=null;toast('Home alone mode on')},
 clr:()=>{S.events=[];S.unread=0},snap:()=>toast('Snapshot saved'),bell:()=>{S.sheet='bell'},add:()=>{pr='Medium';S.sheet='task'},addc:()=>{S.sheet='contact'},diag:()=>{S.sheet='diag'},
 x:()=>{S.sheet=null},x2:()=>{S.sheet=null},
 savet:()=>{const n=$('#tt').value.trim();if(!n)return toast('Enter a task name');const ymd=$('#td').value;
 if(S.google){S.sheet=null;gAddTask(n,pr,ymd).then(()=>toast('Task saved to Google Tasks')).catch(e=>toast(e.message));return}
 const di=dueInfo(ymd);S.tasks.unshift({id:Date.now(),t:n,p:pr,due:di.due,today:di.today,done:0});S.sheet=null;S.sync=Date.now();toast('Task saved and synced to mirror')},
 savec:()=>{const n=$('#cn').value.trim(),p=$('#cp').value.trim();if(!n||!/^\+[1-9]\d{7,14}$/.test(p))return toast('Use a name and a number like +15551234567');S.contacts.push({n,ph:p,r:$('#cr').value});S.sheet=null},
 sync:()=>{S.sync=Date.now();if(S.google){loadCal();loadTasks()}toast('Synced with mirror')},goog:()=>{
  if(S.google){try{localStorage.removeItem(GTOK)}catch(e){}S.google=false;S.cal=[[],[],[]];S.tasks=[];S.tasksLoaded=false;S.cacheT=0;try{localStorage.removeItem('gc_cache');localStorage.setItem('gc_gdis','1')}catch(e){}toast('Google account disconnected');return}
  GOOGLE_OAUTH(true);
 },
 mute:()=>{S.mute=!S.mute;toast(S.mute?'Voice assistant muted':'Voice assistant active')},theme:()=>{S.theme=S.theme=='dark'?'light':'dark';document.documentElement.dataset.theme=S.theme},
 net:()=>{S.cloud=!S.cloud;S.log.unshift({t:S.cloud?'Switched to Cloud GPT-4':'Switched to local LLaMA 3 (internet unavailable)',w:Date.now()})},
 sim:()=>{S.online=!S.online;if(!S.online)S.log.unshift({t:'Connectivity drop',w:Date.now()});else toast('Reconnected ✓')},
 clog:()=>{S.log=[]},out:()=>{db.auth.signOut();['gc_mirror','gc_cache','gc_tok','gc_reauth','gc_gdis'].forEach(k=>{try{localStorage.removeItem(k)}catch(e){}});S.user=null;S.pw=S.pw2='';S.nm='';S.authMode='in';S.err='';S.info='';S.screen='login';S.sec=S.alone=false;S.google=false;S.cal=[[],[],[]];S.tasks=[];S.tasksLoaded=false;S.mirror=null;S.events=[];S.unread=0;S.tab='Alerts'}};
 if(a&&a.startsWith('p_')){const k=a.slice(2);S.prefs[k]=!S.prefs[k];return render()}
 if(m[a]){m[a](d);render()}});
document.addEventListener('keydown',e=>{if(e.key=='Enter'&&['em','pw','pw2','nm'].includes(e.target.id)){e.preventDefault();authGo()}});
document.addEventListener('input',e=>{const id=e.target.id;
 if(id=='em')S.em=e.target.value;if(id=='pw')S.pw=e.target.value;if(id=='pw2')S.pw2=e.target.value;if(id=='nm')S.nm=e.target.value;
 if(['em','pw','pw2','nm'].includes(id)&&S.err){S.err='';const er=$('#err');if(er)er.remove()}
 if(id=='pw'&&(S.authMode=='up'||S.authMode=='reset')){const st=pwStrength(S.pw),bar=$('#strbar'),tx=$('#strtxt');if(bar){bar.style.width=st.pct+'%';bar.style.background=st.col}if(tx)tx.textContent=st.label}
 if(e.target.dataset.a=='br'){S.bright=+e.target.value;e.target.previousElementSibling.querySelector('span').textContent=S.bright+'%'}});
setInterval(()=>{S.up++;if(S.screen!='app')return;
 if(S.online&&S.tab=='Status'&&S.up%5==0){S.temp=Math.max(45,Math.min(85,S.temp+(Math.random()*4-2)));S.cpu=Math.max(5,Math.min(95,S.cpu+(Math.random()*10-5)));S.ram=Math.max(2,Math.min(3.8,S.ram+(Math.random()*.2-.1)));S.hist=[...S.hist.slice(-5),S.temp];render()}
 else if(S.tab=='Status'&&!S.sheet)render();
 if(S.online&&(S.sec||S.alone)&&S.up%25==0){const k=S.alone&&Math.random()<.4?'Fall Alert':'Human Detected';S.events.unshift({k,w:Date.now()});S.unread++;notify(k=='Fall Alert'?'Fall':'Intrusion',k=='Fall Alert'?'Fall detected':'Unknown person detected');if(S.tab!='Alerts')toast('⚠️ '+(k=='Fall Alert'?'Fall detected':'Unknown person detected'));else{S.unread=0;render()}}},1000);
setInterval(()=>{if(S.screen=='app'&&S.tab=='Camera'&&S.online&&S.camOn)draw()},100);
setTimeout(async()=>{try{
 const {data}=await db.auth.getSession();
 if(data.session&&S.authMode!='reset'){
  S.user=data.session.user;S.google=!!gtoken();loadCache();
  const sm=savedMirror();
  if(sm){applyMirror(sm);S.screen='app';S.tab='Alerts';render();refreshMirror()}
  else{S.screen='connect';render();loadMirrors()}
  loadCal();loadTasks();reauthGoogle();return;
 }
}catch(e){}S.screen='login';render()},1500);
addEventListener('offline',()=>{S.netOff=true;render()});
addEventListener('online',()=>{S.netOff=false;render();loadCal();loadTasks();refreshMirror()});
document.addEventListener('visibilitychange',()=>{if(!document.hidden){reauthGoogle();refreshMirror()}});
setInterval(refreshMirror,30000);
render();
